# =============================================================================
# フロント（ブラウザに埋め込まれるため秘密情報を入れない）
# =============================================================================

# true のとき RSVP API を呼ばず UI のみ検証（開発用）
# NEXT_PUBLIC_RSVP_DRY_RUN=true

# =============================================================================
# RSVP API（/api/rsvp）— Google スプレッドシート必須
# =============================================================================

# 書き込み先スプレッドシート ID（URL の /d/ と /edit の間）
GOOGLE_SPREADSHEET_ID=

# 画像アップロードを使う場合のみ必須。Drive 上のフォルダ ID（共有ドライブ推奨）
# GOOGLE_DRIVE_RSVP_FOLDER_ID=

# -----------------------------------------------------------------------------
# Google 認証（スプレッドシートはサービスアカウントのみ）
# 次のどちらか一方を設定:
#
# A) JSON 鍵ファイルのパス
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/absolute/path/to/service-account.json
# または標準の変数名:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# B) 環境変数に直接（Vercel 等）
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# -----------------------------------------------------------------------------

# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Drive 保存先: サービスアカウントはマイドライブ容量がないため、
# 共有ドライブ上の GOOGLE_DRIVE_RSVP_FOLDER_ID を使うか、
# 次の OAuth 3 点セットで「ユーザーの Drive」に保存する。
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# -----------------------------------------------------------------------------

# =============================================================================
# 補助スクリプト（リフレッシュトークン取得用）
# npm スクリプトから oauth-drive-token.mjs / oauth-drive-exchange-code.mjs
# =============================================================================

# OAUTH_DRIVE_PORT=8765
# GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth2callback
